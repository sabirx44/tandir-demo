---
// Print-ready A6 table cards: one QR per table, linking to the menu in this language.
import Base from '../../layouts/Base.astro';
import QRCode from 'qrcode';
import { chekich } from '../../components/Chekich';
import { ui } from '../../i18n/ui';
import { path, staticLangPaths, type Lang } from '../../i18n/langs';

export const getStaticPaths = staticLangPaths;
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].tables;
const menuUrl = new URL(path(lang, '/menu/'), Astro.site).href;
const cards = await Promise.all(Array.from({ length: 12 }, (_, i) => i + 1).map(async (n) => ({
  n, svg: await QRCode.toString(`${menuUrl}?t=${n}`, { type: 'svg', margin: 0, color: { dark: '#110D0A', light: '#00000000' } }),
})));
const rosette = chekich({ petals: 12, stroke: 1.4 });
---
<Base lang={lang} title={`${t.title} — Tandir Hall`} description={t.text} page="/tables/" smooth={false}>
  <div class="no-print mx-auto flex max-w-5xl flex-wrap items-end justify-between gap-6 px-5 py-10">
    <div>
      <h1 class="display t-l">{t.title}</h1>
      <p class="mt-3 max-w-[50ch] text-flour/70">{t.text}</p>
    </div>
    <button type="button" class="btn btn-ember" onclick="window.print()">{t.print}</button>
  </div>
  <div class="sheet mx-auto grid max-w-5xl gap-5 px-5 pb-20 sm:grid-cols-2">
    {cards.map((c) => (
      <article class="card">
        <div class="card-rosette" set:html={rosette} />
        <div class="relative flex items-start justify-between">
          <p class="display text-[26px] leading-none">Tandir Hall</p>
          <p class="display num text-[54px] leading-[0.8]" dir="ltr">{String(c.n).padStart(2, '0')}</p>
        </div>
        <div class="qr relative" set:html={c.svg} />
        <div class="relative">
          <p class="display text-[24px] leading-[1.05]">{t.card}</p>
          <p class="mt-2 text-[12px] opacity-70">{t.scan} · RU · UZ · KZ · EN · AR</p>
        </div>
      </article>
    ))}
  </div>
</Base>

<style>
  .card { position: relative; overflow: hidden; aspect-ratio: 105 / 148; border-radius: 22px; padding: 26px; display: flex; flex-direction: column; justify-content: space-between; background: var(--color-crust); color: var(--color-soot); }
  .card-rosette { position: absolute; width: 120%; inset-inline-end: -45%; bottom: -35%; color: var(--color-ember); opacity: .22; }
  .qr { width: 56%; margin-inline: auto; background: var(--color-flour); border-radius: 18px; padding: 14px; }
  .qr :global(svg) { display: block; width: 100%; height: auto; }
  @media print {
    @page { size: A4; margin: 8mm; }
    :global(html), :global(body) { background: #fff !important; }
    .no-print { display: none; }
    .sheet { grid-template-columns: 1fr 1fr; gap: 6mm; padding: 0; max-width: none; }
    .card { width: 95mm; height: 134mm; aspect-ratio: auto; break-inside: avoid; border-radius: 6mm; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
